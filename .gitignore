# PTL-v2 source-of-truth repository
# Biological data and derived matrices never enter Git.
/data/raw/
/data/interim/
/data/processed/
/data/external/
/data/cache/
**/*.h5ad
**/*.h5
**/*.loom
**/*.npz
**/*.npy
**/*.parquet
**/*.feather
**/*.pkl
**/*.pickle

# Generated results and artifacts are opt-in only.
/results/
/artifacts/*
!/artifacts/README.md
!/artifacts/manifests/
!/artifacts/manifests/README.md
!/artifacts/manifests/*.csv
!/artifacts/manifests/*.json
!/artifacts/manifests/*.md
!/artifacts/source_data/
!/artifacts/source_data/README.md
!/artifacts/source_data/*.csv
**/ptl_oof_predictions.csv

# Local QA/cache trees and compiled documents.
/.cache/
/tmp/
/.pytest-final.*
/.pytest-full-*
/.pytest-tmp-*/
/_pandas3_runtime_*/
**/*.stderr.log
**/*.stdout.log
artifacts/manifests/*_part[0-9][0-9].*
artifacts/manifests/*_part[0-9][0-9]_*.*
artifacts/manifests/reliability_transport_measurement_depth_parts/
artifacts/manifests/_depth_direct_smoke/
artifacts/manifests/_depth_label_smoke/
# Full item-level depth material is reproducible from the canonical summary,
# decision, coverage and resolution tables but is too large for the repository.
/artifacts/manifests/reliability_transport_measurement_depth_items.csv
/artifacts/manifests/reliability_transport_measurement_depth_matched_fixed_items.csv
/artifacts/manifests/reliability_transport_measurement_depth_matched_fixed_risks.csv
/artifacts/manifests/reliability_transport_measurement_depth_matched_fixed_macro_bootstrap.csv
/artifacts/manifests/reliability_transport_measurement_depth_matched_fixed_decision_macro_bootstrap.csv
# Source-disjoint remote shards and logs are reproducible intermediates; the
# validated canonical tables and manifests at the manifest root are retained.
/artifacts/manifests/reliability_transport_measurement_depth_matched_fixed_parts/
/artifacts/manifests/*.err.log
/artifacts/manifests/*.out.log
/artifacts/manifests/reliability_transport_metric_pair_states.csv
# Local CUDA/QA probes are not claim inputs.
/artifacts/manifests/formal_v2_claim_lock_guide_composition_coverage_cuda_check*.csv
**/*.pdf

# Submission bundles and generated publication outputs.
/submit/
/submission_package/
/manuscript/*.pdf
/manuscript/*.aux
/manuscript/*.bbl
/manuscript/*.blg
/manuscript/*.fdb_latexmk
/manuscript/*.fls
/manuscript/*.log
/manuscript/*.out
/paper/iclr2027/*.aux
/paper/iclr2027/*.bbl
/paper/iclr2027/*.blg
/paper/iclr2027/*.fdb_latexmk
/paper/iclr2027/*.fls
/paper/iclr2027/*.log
/paper/iclr2027/*.out
# Local raster previews made while reviewing the reordered submission.
/paper/iclr2027/main_reordered_page-1.png
/paper/iclr2027/main_reordered_page-2.png

# Historical checkout and nested third-party repository internals.
/_github_ptl_work/
/third_party/GEARS/
/third_party/systema/
/third_party/TxPert/
/third_party/State/

# Python, local environments, caches and editor files.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.env
.env.*
!.env.example
.idea/
.vscode/
*.swp
*.swo

# OS files.
.DS_Store
Thumbs.db
